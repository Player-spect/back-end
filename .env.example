# Copiar a .env (o .env.local para desarrollo) y completar valores.
SECRET_KEY=cambia-esta-clave
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL (producción). Si DB_HOST está vacío se usa SQLite en desarrollo.
DB_NAME=gestion_corporativa
DB_USER=usuario
DB_PASSWORD=contraseña
DB_HOST=localhost
DB_PORT=3306

# Email SMTP para recuperación de contraseña
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.ejemplo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=correo@ejemplo.cl
EMAIL_HOST_PASSWORD=contraseña
DEFAULT_FROM_EMAIL=no-reply@ejemplo.cl
